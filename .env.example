# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AA...your-token-here

# Comma or space separated Telegram user IDs allowed to use the bot.
# Get yours from @userinfobot. STRONGLY recommended - leave empty and
# anyone who finds the bot can use your GitHub accounts!
OWNER_IDS=123456789

# ---------------------------------------------------------------------
# MongoDB CLUSTER connection string (e.g. MongoDB Atlas).
# All bot state lives here, so you can move the bot to a new server and
# it resumes exactly where it left off.
#
# Atlas: Database -> Connect -> Drivers -> copy the connection string.
# Remember to allow your server's IP in Atlas Network Access
# (or 0.0.0.0/0 if your server IP changes).
# ---------------------------------------------------------------------
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# MongoDB database name
MONGO_DB=codespace_keeper

# Seconds between keep-alive SSH pings (default 300 = 5 minutes)
KEEPALIVE_INTERVAL=300

# Seconds between codespace state checks (default 60). The watcher detects
# when a codespace starts - no matter when or where it was started (bot,
# github.com, VS Code, gh CLI) - and runs its startup commands automatically.
WATCH_INTERVAL=60

# Timezone for the daily auto start/stop schedule AND for every time the
# bot displays (last ping etc.). Also sets the container clock, so this
# works the same no matter which country your server runs in.
# Default: IST.
SCHEDULE_TZ=Asia/Kolkata
